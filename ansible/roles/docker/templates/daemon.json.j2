{
  "userland-proxy": false,
  "log-driver": "local",
  "log-opts": { "max-size": "20m", "max-file": "5" },
  "live-restore": true{% if docker_mtu | string | length > 0 %},
  "mtu": {{ docker_mtu }},
  "default-network-opts": {
    "bridge": { "com.docker.network.driver.mtu": "{{ docker_mtu }}" }
  }{% endif %}{% if nvidia_enabled %},
  "runtimes": {
    "nvidia": { "path": "nvidia-container-runtime", "args": [] }
  }{% endif %}

}
