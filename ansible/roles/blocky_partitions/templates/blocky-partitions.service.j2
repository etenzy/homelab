# {{ ansible_managed }}
[Unit]
Description=Maintain log_entries partitions
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User={{ blocky_partitions_owner }}
ExecStart=/usr/bin/psql -d {{ blocky_partitions_db }} -v ON_ERROR_STOP=1 \
  -c "SELECT maintain_log_entries_partitions();"
