-- {{ ansible_managed }}
-- Weekly partitions for blocky's query log (log_entries). Creates the current
-- week plus p_premake weeks ahead, drops partitions older than p_retention and
-- applies the storage parameters to every partition (a partitioned parent
-- cannot carry them itself).
-- Owned by blocky so it can create and drop partitions of blocky's table.
SET ROLE {{ blocky_partitions_owner }};

CREATE OR REPLACE FUNCTION public.maintain_log_entries_partitions(
    p_premake   int      DEFAULT {{ blocky_partitions_premake | int }},
    p_retention interval DEFAULT '{{ blocky_partitions_retention }}'
) RETURNS void
LANGUAGE plpgsql
AS $$
DECLARE
    v_week   date;
    v_part   text;
    v_cutoff date := (now() - p_retention)::date;
    v_opts   text := {% if blocky_partitions_reloptions %}'{% for k, v in blocky_partitions_reloptions.items() %}{{ k }} = {{ v }}{{ ', ' if not loop.last }}{% endfor %}'{% else %}NULL{% endif %};
    r        record;
BEGIN
    -- Current week plus p_premake weeks ahead.
    FOR i IN 0..p_premake LOOP
        v_week := (date_trunc('week', now()) + (i || ' weeks')::interval)::date;
        v_part := format('log_entries_%s', to_char(v_week, 'IYYY_"w"IW'));

        IF to_regclass('public.' || v_part) IS NULL THEN
            EXECUTE format(
                'CREATE TABLE %I PARTITION OF log_entries FOR VALUES FROM (%L) TO (%L)',
                v_part, v_week, v_week + 7);
            RAISE NOTICE 'created: % (% to %)', v_part, v_week, v_week + 7;
        END IF;
    END LOOP;

    -- Drop partitions whose upper bound lies before the cutoff.
    FOR r IN
        SELECT c.oid::regclass::text AS part,
               (regexp_match(pg_get_expr(c.relpartbound, c.oid),
                             'TO \(''([^'']+)''\)'))[1]::timestamptz AS upper_bound
        FROM pg_class c
        JOIN pg_inherits i ON i.inhrelid = c.oid
        WHERE i.inhparent = 'log_entries'::regclass
          AND pg_get_expr(c.relpartbound, c.oid) <> 'DEFAULT'
        ORDER BY 2
    LOOP
        IF r.upper_bound <= v_cutoff THEN
            EXECUTE format('DROP TABLE %s', r.part);
            RAISE NOTICE 'dropped: % (up to %)', r.part, r.upper_bound::date;
        END IF;
    END LOOP;

    -- Storage parameters (autovacuum) on all remaining partitions, incl. default.
    IF v_opts IS NOT NULL THEN
        FOR r IN
            SELECT c.oid::regclass::text AS part
            FROM pg_class c
            JOIN pg_inherits i ON i.inhrelid = c.oid
            WHERE i.inhparent = 'log_entries'::regclass
        LOOP
            EXECUTE format('ALTER TABLE %s SET (%s)', r.part, v_opts);
        END LOOP;
    END IF;
END;
$$;

RESET ROLE;
