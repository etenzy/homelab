-- {{ ansible_managed }}
-- Deletes recent query log entries whose question_name matches one of the
-- LIKE patterns in blocky_purge_patterns (host_vars/<host>/vault.yml).
\set ON_ERROR_STOP on

WITH deleted AS (
    DELETE FROM log_entries
    WHERE request_ts >= now() - interval '{{ blocky_purge_window }}'
      AND (
{% for pattern in blocky_purge_patterns | unique | sort %}
           {{ "OR " if not loop.first else "   " }}question_name LIKE '{{ pattern | replace("'", "''") }}'
{% endfor %}
          )
    RETURNING 1
)
SELECT count(*) AS deleted FROM deleted;
