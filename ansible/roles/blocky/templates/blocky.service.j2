# {{ ansible_managed }}
[Unit]
Description=Blocky DNS proxy and ad-blocker
Documentation=https://0xERR0R.github.io/blocky/
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=blocky
Group=blocky

WorkingDirectory=/var/lib/blocky
ExecStartPre=/usr/local/bin/blocky validate --config /etc/blocky/config.yml
ExecStart=/usr/local/bin/blocky serve --config /etc/blocky/config.yml

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

Restart=on-failure
RestartSec=5
TimeoutStopSec=20

StateDirectory=blocky
StateDirectoryMode=0750

StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=blocky

[Install]
WantedBy=multi-user.target
