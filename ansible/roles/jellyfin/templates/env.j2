# {{ ansible_managed }}
JELLYFIN_EXPORTER_TOKEN={{ jellyfin_exporter_token }}
{% if media_mounts | selectattr('type', 'eq', 'cifs') | list | length > 0 %}
# Single quotes: no interpolation of $ inside. No commas (mount option separator).
NAS_CIFS_USER='{{ jellyfin_cifs_user }}'
NAS_CIFS_PASSWORD='{{ jellyfin_cifs_password }}'
{% endif %}
